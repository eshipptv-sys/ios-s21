+/*
+ * o1s (Exynos 2100): volume keys on GPIO bank gpa0 (GPIO_CMGPEINT at
+ * 0x14ec0000, data register +4): Vol+ = bit 3, Vol- = bit 4, active low
+ * (released = 1), confirmed on the phone by the shim probe. Power/side
+ * key is on the S2MPS23 PMIC, not wired yet. sweet_hid_key: 1 = vol up,
+ * 2 = vol down.
+ */
+#define GPA0_PA          0x14ec0000u
+#define GPA0_DAT_OFF     0x4u
+#define GPA0_VOLUP       (1u << 3)
+#define GPA0_VOLDN       (1u << 4)
+static vm_offset_t gpa0_base;
+
+static void
+keys_o1s_thread(void *arg, wait_result_t result)
+{
+	int state[3] = { 0, 0, 0 };
+	(void)arg;
+	(void)result;
+	for (;;) {
+		uint32_t dat = *(volatile uint32_t *)(gpa0_base + GPA0_DAT_OFF);
+		int now[3] = { 0, !(dat & GPA0_VOLUP), !(dat & GPA0_VOLDN) };
+		for (int k = 1; k < 3; ++k) {
+			if (now[k] != state[k]) {
+				state[k] = now[k];
+				printf("SWEET KEYS: o1s key=%d down=%d dat=%#x\n", k, state[k], dat & 0xffu);
+				sweet_hid_key(k, state[k]);
+			}
+		}
+		keys_wait();
+	}
+}
+
+void sweet_keys_o1s_init(void);
+void
+sweet_keys_o1s_init(void)
+{
+	thread_t thread;
+	if (keys_started) {
+		return;
+	}
+	keys_started = true;
+	gpa0_base = ml_io_map(GPA0_PA, 0x1000);
+	if (!gpa0_base) {
+		printf("SWEET KEYS: o1s gpa0 map failed\n");
+		return;
+	}
+	if (kernel_thread_start(keys_o1s_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		printf("SWEET KEYS: o1s gpa0 volume keys active (dat %#x)\n",
+		    *(volatile uint32_t *)(gpa0_base + GPA0_DAT_OFF) & 0xffu);
+	} else {
+		printf("SWEET KEYS: o1s thread start failed\n");
+	}
+}
+
 void
 sweet_keys_init(void)
 {
